{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "allowUmdGlobalAccess": true,
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist/js",
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src"
  ]
}
